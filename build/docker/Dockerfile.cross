# Cross-compile Wails v3 apps to any platform
#
# Darwin: Zig + macOS SDK
# Linux: Native GCC when host matches target, Zig for cross-arch
# Windows: Zig + bundled mingw
#
# Usage:
#   docker build -t wails-cross -f Dockerfile.cross .
#   docker run --rm -v $(pwd):/app wails-cross darwin arm64
#   docker run --rm -v $(pwd):/app wails-cross darwin amd64
#   docker run --rm -v $(pwd):/app wails-cross linux amd64
#   docker run --rm -v $(pwd):/app wails-cross linux arm64
#   docker run --rm -v $(pwd):/app wails-cross windows amd64
#   docker run --rm -v $(pwd):/app wails-cross windows arm64

# Debian 13 provides the GTK >= 4.14 API baseline used by the default Linux backend.
FROM debian:trixie

ARG TARGETARCH
ARG GARBLE_VERSION=v0.16.0
ARG GO_VERSION=1.26.0

# Install Go (golang official images do not ship a trixie variant, so we
# install it ourselves on top of debian:trixie to keep the GTK4 >= 4.14 baseline).
RUN GO_ARCH=$(case "${TARGETARCH}" in arm64) echo "arm64" ;; *) echo "amd64" ;; esac) && \
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && \
    curl -fSL "https://golang.google.cn/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tgz && \
    tar -C /usr/local -xzf /tmp/go.tgz && \
    rm /tmp/go.tgz && \
    rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/local/go/bin:/root/go/bin:$PATH

# Install base tools, GCC, and GTK/WebKit dev packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl xz-utils python3 nodejs npm pkg-config gcc libc6-dev \
    libgtk-3-dev libwebkit2gtk-4.1-dev \
    libgtk-4-dev libwebkitgtk-6.0-dev \
    && pkg-config --atleast-version=4.14 gtk4 \
    && pkg-config --exists webkitgtk-6.0 \
    && pkg-config --exists gtk+-3.0 \
    && pkg-config --exists webkit2gtk-4.1 \
    && rm -rf /var/lib/apt/lists/*

RUN GOPROXY=https://goproxy.cn,direct go install mvdan.cc/garble@${GARBLE_VERSION}

# Install the wails3 CLI (same version the app depends on) so linuxdeploy-based
# AppImage generation can run inside the container. It must run here, not on the
# Windows host: `wails3 generate appimage` walks /usr for the GTK/WebKit runtime
# files (findGTKFiles) and invokes linuxdeploy — both only exist in the Linux
# toolchain. The CLI needs no CGO; Go installs to /root/go/bin which is on PATH.
ARG WAILS_VERSION=v3.0.0-beta.24
RUN GOPROXY=https://goproxy.cn,direct go install github.com/wailsapp/wails/v3/cmd/wails3@${WAILS_VERSION} \
    && wails3 version

# Install Zig - automatically selects correct binary for host architecture.
# The SHA-256 is fetched from Zig's official download manifest and verified
# before extraction to protect against MITM or corrupted downloads.
# Set SKIP_CROSS_TOOLS=true to skip Zig + macOS SDK (only needed for darwin/windows targets).
ARG SKIP_CROSS_TOOLS=false
ARG ZIG_VERSION=0.14.0
RUN if [ "$SKIP_CROSS_TOOLS" = "true" ]; then echo "Skipping Zig install"; else \
    ZIG_ARCH=$(case "${TARGETARCH}" in arm64) echo "aarch64" ;; *) echo "x86_64" ;; esac) && \
    ZIG_FILE="zig-linux-${ZIG_ARCH}-${ZIG_VERSION}.tar.xz" && \
    curl -fSL "https://ziglang.org/download/${ZIG_VERSION}/${ZIG_FILE}" -o "/tmp/${ZIG_FILE}" && \
    EXPECTED=$(curl -fsSL "https://ziglang.org/download/index.json" | \
        python3 -c "import json,sys; d=json.load(sys.stdin); print(d[sys.argv[1]][sys.argv[2]+'-linux']['shasum'])" \
        "${ZIG_VERSION}" "${ZIG_ARCH}") && \
    echo "${EXPECTED}  /tmp/${ZIG_FILE}" | sha256sum -c - && \
    tar -xJ -f "/tmp/${ZIG_FILE}" -C /opt && \
    rm "/tmp/${ZIG_FILE}" && \
    ln -s /opt/zig-linux-${ZIG_ARCH}-${ZIG_VERSION}/zig /usr/local/bin/zig; \
    fi

# Download macOS SDK (required for darwin targets)
ARG MACOS_SDK_VERSION=14.5
RUN if [ "$SKIP_CROSS_TOOLS" = "true" ]; then echo "Skipping macOS SDK download"; else \
    curl -L "https://github.com/joseluisq/macosx-sdks/releases/download/${MACOS_SDK_VERSION}/MacOSX${MACOS_SDK_VERSION}.sdk.tar.xz" \
    | tar -xJ -C /opt \
    && mv /opt/MacOSX${MACOS_SDK_VERSION}.sdk /opt/macos-sdk; \
    fi

ENV MACOS_SDK_PATH=/opt/macos-sdk

# Install rcodesign (pure-Rust reimplementation of Apple codesign).
# Apple Silicon (arm64) macOS kills unsigned Mach-O executables at launch,
# so darwin artifacts need at least an ad-hoc signature. rcodesign lets us
# ad-hoc sign the .app bundle from Linux without a Mac or an Apple certificate.
# musl builds are static and run on any glibc base.
ARG RCODESIGN_VERSION=0.29.0
RUN RCODESIGN_ARCH=$(case "${TARGETARCH}" in arm64) echo "aarch64" ;; *) echo "x86_64" ;; esac) && \
    BASE_URL="https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign/${RCODESIGN_VERSION}" && \
    PKG="apple-codesign-${RCODESIGN_VERSION}-${RCODESIGN_ARCH}-unknown-linux-musl.tar.gz" && \
    curl -fSL "${BASE_URL}/${PKG}" -o /tmp/rcodesign.tar.gz && \
    curl -fSL "${BASE_URL}/${PKG}.sha256" -o /tmp/rcodesign.tar.gz.sha256 && \
    cd /tmp && echo "$(cat rcodesign.tar.gz.sha256)  rcodesign.tar.gz" | sha256sum -c - && \
    mkdir -p /tmp/rcext && tar -xzf rcodesign.tar.gz -C /tmp/rcext && \
    install -m 0755 "$(find /tmp/rcext -name rcodesign -type f | head -n1)" /usr/local/bin/rcodesign && \
    rm -rf /tmp/rcodesign.tar.gz /tmp/rcodesign.tar.gz.sha256 /tmp/rcext

# DMG toolchain for packaging macOS .dmg on Linux hosts (hdiutil is
# macOS-only). xorriso (libisofs) stages an ISO9660/Rock Ridge + native HFS+
# hybrid image (HFS+ catalog records carry real symlinks, unlike cdrkit's
# genisoimage -hfs which only writes them into Rock Ridge metadata); mozilla's
# libdmg-hfsplus builds the `dmg` converter that wraps the image into a
# standard UDZO-compressed UDIF image mountable by DiskImageMounter.
ARG LDMG_VERSION=master
RUN apt-get update && apt-get install -y --no-install-recommends \
    xorriso cmake make g++ zlib1g-dev libbz2-dev \
    && mkdir -p /tmp/libdmg-hfsplus \
    && curl --retry 5 --retry-delay 2 --retry-all-errors -fSL \
      "https://github.com/mozilla/libdmg-hfsplus/archive/refs/heads/${LDMG_VERSION}.tar.gz" \
      | tar -xz -C /tmp/libdmg-hfsplus --strip-components=1 \
    && sed -i 's/^IF(OPENSSL_FOUND)/IF(FALSE)/' /tmp/libdmg-hfsplus/dmg/CMakeLists.txt \
    && cmake -S /tmp/libdmg-hfsplus -B /tmp/libdmg-hfsplus/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /tmp/libdmg-hfsplus/build -j"$(nproc)" \
    && install -m 0755 "$(find /tmp/libdmg-hfsplus/build -name dmg -type f -executable | head -n1)" /usr/local/bin/dmg \
    && command -v xorriso >/dev/null && command -v dmg >/dev/null \
    && rm -rf /tmp/libdmg-hfsplus /var/lib/apt/lists/*

# Patch the Go standard library for macOS 12 compatibility:
# crypto/x509 hard-imports SecTrustCopyCertificateChain (macOS 13+), causing a
# dyld abort on macOS 12 during TLS certificate verification. Replace it with a
# dlsym-based C shim that falls back to the pre-13 SecTrustGetCertificate*
# APIs. Original behaviour is preserved for CGO_ENABLED=0.
COPY patches/ /tmp/go-patches/
RUN python3 /tmp/go-patches/patch_go_stdlib.py /usr/local/go && rm -rf /tmp/go-patches

# Create Zig CC wrappers for cross-compilation targets
# Darwin and Windows use Zig; Linux uses native GCC (run with --platform for cross-arch)

# Darwin arm64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target aarch64-macos.12.0-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-arm64

# Darwin amd64
COPY <<'ZIGWRAP' /usr/local/bin/zcc-darwin-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -mmacosx-version-min=*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -fno-sanitize=all -target x86_64-macos.12.0-none -isysroot /opt/macos-sdk -I/opt/macos-sdk/usr/include -L/opt/macos-sdk/usr/lib -F/opt/macos-sdk/System/Library/Frameworks -w $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-darwin-amd64

# Windows amd64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-amd64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target x86_64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-amd64

# Windows arm64 - uses Zig's bundled mingw
COPY <<'ZIGWRAP' /usr/local/bin/zcc-windows-arm64
#!/bin/sh
ARGS=""
SKIP_NEXT=0
for arg in "$@"; do
    if [ $SKIP_NEXT -eq 1 ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -target) SKIP_NEXT=1 ;;
        -Wl,*) ;;
        *) ARGS="$ARGS $arg" ;;
    esac
done
exec zig cc -target aarch64-windows-gnu $ARGS
ZIGWRAP
RUN chmod +x /usr/local/bin/zcc-windows-arm64

# Build script
COPY <<'SCRIPT' /usr/local/bin/build.sh
#!/bin/sh
set -e

# Use Chinese Go module proxy (proxy.golang.org is not reachable from this network)
export GOPROXY=https://goproxy.cn,direct
export GOSUMDB=off

OS=${1:-darwin}
ARCH=${2:-arm64}

case "${OS}-${ARCH}" in
    darwin-arm64|darwin-aarch64)
        export CC=zcc-darwin-arm64
        export GOARCH=arm64
        export GOOS=darwin
        ;;
    darwin-amd64|darwin-x86_64)
        export CC=zcc-darwin-amd64
        export GOARCH=amd64
        export GOOS=darwin
        ;;
    linux-arm64|linux-aarch64)
        export CC=gcc
        export GOARCH=arm64
        export GOOS=linux
        ;;
    linux-amd64|linux-x86_64)
        export CC=gcc
        export GOARCH=amd64
        export GOOS=linux
        ;;
    windows-arm64|windows-aarch64)
        export CC=zcc-windows-arm64
        export GOARCH=arm64
        export GOOS=windows
        ;;
    windows-amd64|windows-x86_64)
        export CC=zcc-windows-amd64
        export GOARCH=amd64
        export GOOS=windows
        ;;
    *)
        echo "Usage: <os> <arch>"
        echo "  os: darwin, linux, windows"
        echo "  arch: amd64, arm64"
        exit 1
        ;;
esac

export CGO_ENABLED=1
export CGO_CFLAGS="-w"

# Build frontend if exists and not already built (host may have built it)
if [ -d "frontend" ] && [ -f "frontend/package.json" ] && [ ! -d "frontend/dist" ]; then
    (cd frontend && npm install --silent && npm run build --silent)
fi

# Build
APP=${APP_NAME:-$(basename $(pwd))}
mkdir -p bin

EXT=""
LDFLAGS="-s -w"
if [ "$GOOS" = "windows" ]; then
    EXT=".exe"
    LDFLAGS="-s -w -H windowsgui"
fi

TAGS="production"
if [ -n "$EXTRA_TAGS" ]; then
    TAGS="${TAGS},${EXTRA_TAGS}"
fi

COMPILER="go build"
if [ "$OBFUSCATED" = "true" ]; then
    COMPILER="garble ${GARBLE_ARGS} build"
    TAGS="${TAGS},wails_obfuscated"
fi

${COMPILER} -tags "$TAGS" -trimpath -buildvcs=false -ldflags="$LDFLAGS" -o bin/${APP}-${GOOS}-${GOARCH}${EXT} .
echo "Built: bin/${APP}-${GOOS}-${GOARCH}${EXT}"
SCRIPT
RUN chmod +x /usr/local/bin/build.sh

# .app bundle assembly helper (used via --entrypoint for darwin packaging)
COPY darwin-bundle.sh /usr/local/bin/darwin-bundle.sh
RUN chmod +x /usr/local/bin/darwin-bundle.sh

# .dmg packaging helper (used via --entrypoint for darwin packaging)
COPY darwin-dmg.sh /usr/local/bin/darwin-dmg.sh
RUN chmod +x /usr/local/bin/darwin-dmg.sh

# Normalise line endings of all shell scripts (the Dockerfile may carry CRLF on
# Windows hosts, which would break the shebang inside the Linux container).
RUN sed -i 's/\r$//' /usr/local/bin/build.sh /usr/local/bin/darwin-bundle.sh /usr/local/bin/darwin-dmg.sh /usr/local/bin/zcc-* 2>/dev/null || true

# AppImage tooling deps. linuxdeploy's gtk plugin needs dpkg-architecture
# (dpkg-dev) and `file` to resolve library sonames. Kept as the LAST layer so
# adding it doesn't invalidate the expensive Zig/macOS-SDK/rcodesign layers
# above — those re-download from GitHub and fail when the network can't reach
# github.com, so they must stay cache-stable.
RUN apt-get update && apt-get install -y --no-install-recommends \
    dpkg-dev file \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENTRYPOINT ["/usr/local/bin/build.sh"]
CMD ["darwin", "arm64"]
